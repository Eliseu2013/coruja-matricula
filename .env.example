# Copie este arquivo para ".env" e preencha os valores. NUNCA envie o .env para o Git.

# NODE_ENV: use "production" no servidor real (ativa CSP com HTTPS, esconde erros e exige JWT_SECRET)
NODE_ENV=development

# GEMINI_API_KEY: chave da API Gemini (leitura automática de documentos). Opcional.
GEMINI_API_KEY=

# APP_URL: endereço público do sistema (ex.: https://matricula.exemplo.com). Usado no CORS.
# No Render não precisa: o servidor usa a variável RENDER_EXTERNAL_URL, que o Render define sozinho.
APP_URL=http://localhost:3000

# DATABASE_URL: PostgreSQL (opcional). Atenção: hoje as operações usam os arquivos JSON de data/.
DATABASE_URL=

# DATABASE_CA_CERT: certificado CA do provedor do PostgreSQL (texto PEM, começa com
# -----BEGIN CERTIFICATE-----). Em produção o certificado do banco é sempre conferido.
DATABASE_CA_CERT=

# DATABASE_SSL_INSECURE: coloque 1 SÓ se o provedor não oferecer o CA e for temporário.
# Com 1, o certificado do banco NÃO é conferido (risco de alguém se passar pelo banco).
DATABASE_SSL_INSECURE=

# JWT_SECRET: segredo de assinatura das sessões. OBRIGATÓRIO em produção, mínimo 32 caracteres.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PORT: porta do servidor HTTP (padrão 3000)
PORT=3000

# BACKUP_CRON_SCHEDULE: expressão cron do backup automático (padrão: todo dia à meia-noite)
BACKUP_CRON_SCHEDULE="0 0 * * *"

# BACKUP_RETENTION_DAYS: por quantos dias manter os arquivos de backup
BACKUP_RETENTION_DAYS=30
